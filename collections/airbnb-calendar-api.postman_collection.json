          "id": "bdce1c73-5e25-423f-94d7-fa69800f2c67",
          "name": "Update Listing Calendar",
          "request": {
            "name": "Update Listing Calendar",
            "description": {
              "content": "Updates the availability, pricing, and minimum stay settings for specific dates on a listing calendar. Use this endpoint to block or unblock dates, adjust nightly pricing, and set minimum stay requirements.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "listings",
                ":listing_id",
                "calendar"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "listing_id",
                  "description": "(Required) The unique identifier of the listing."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calendar_operations\": [\n    {\n      \"start_date\": \"<date>\",\n      \"end_date\": \"<date>\",\n      \"available\": \"<boolean>\",\n      \"price\": \"<double>\",\n      \"minimum_nights\": \"<integer>\",\n      \"maximum_nights\": \"<integer>\"\n    },\n    {\n      \"start_date\": \"<date>\",\n      \"end_date\": \"<date>\",\n      \"available\": \"<boolean>\",\n      \"price\": \"<double>\",\n      \"minimum_nights\": \"<integer>\",\n      \"maximum_nights\": \"<integer>\"\n    }\n  ]\n}",
